# Example client profile. Copy to /etc/wireguard/wg-home.conf and replace every placeholder.
# Keep this file private. The [Interface] PrivateKey is a device secret.
[Interface]
PrivateKey = REPLACE_WITH_CLIENT_PRIVATE_KEY
Address = 10.77.0.2/32
DNS = 1.1.1.1

[Peer]
PublicKey = REPLACE_WITH_SERVER_PUBLIC_KEY
Endpoint = YOUR_HOME_PUBLIC_IP_OR_DDNS:51820
AllowedIPs = 0.0.0.0/0
PersistentKeepalive = 25
